# Copy to .env for local development only. Never commit .env or put real values here.
# Setup guide: docs/database/app_database_setup.md
APP_ENV=development

# --- App database (farmx_app, PostgreSQL 17) ---------------------------------
# Filled from the ETL repo by `publish-app-db`. Holds pseudonymised research data:
# keep it on this machine only. One login per purpose (least privilege).
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=farmx_app
# FastAPI backend: reads core, model_input and every cN_output; writes app.
APP_DB_API_USER=farmx_api
APP_DB_API_PASSWORD=
# Component 1 (PFOI) model jobs: read core, model_input and other cN_output; write c1_output.
APP_DB_PFOI_USER=farmx_model
APP_DB_PFOI_PASSWORD=
# Other components add their own login here, e.g. APP_DB_C2_USER / APP_DB_C2_PASSWORD.

# --- Services ----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- LLM / vector store (synthetic or approved aggregate data only; never farm rows) ---
LLM_PROVIDER=
LLM_API_KEY=
VECTOR_STORE_PROVIDER=
